{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaiduMap": {
    "Ak": "",
    "BaseUrl": "https://api.map.baidu.com",
    "UseMockWhenNoAk": false,
    "MaxQps": 3,
    "RouteMatrixMaxQps": 30,
    "RouteMatrixBatchIntervalMs": 300,
    "RouteMatrixMaxDestinationsPerRequest": 50,
    "PoiSearchDailyLimit": 5000,
    "GeocodeDailyLimit": 5000,
    "RouteMatrixDailyLimit": 5000
  },
  "Llm": {
    "ApiBaseUrl": "",
    "ApiKey": "",
    "Model": "",
    "UseMockWhenNoKey": true,
    "Temperature": 0.3
  },
  "Agent": {
    "MaxConcurrency": 1,
    "IsochroneSampleDirections": 24,
    "IsochroneMinutes": 15,
    "MapApiWalkingSpeedMps": 1.2,
    "IsochroneBinarySearchIterations": 6
  },
  "BlindArea": {
    "GridSizeMeters": 100,
    "MinInsideRatio": 0.5,
    "DefaultReachThresholdMeters": 1000,
    "DetourFactor": 1.3
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "UseMemoryFallback": true
  }
}
