# ===== 项目根目录环境变量（后端 + 前端 + docker-compose 共用）=====

# 百度地图「服务端」应用 AK（Web 服务 API：地理编码、POI、路径规划等）
# 必填：等时圈与 POI 检索依赖真实路网，已关闭 Mock 模式
# 申请：https://lbsyun.baidu.com/apiconsole/key
# 应用类型选「服务端」，白名单配置服务器 IP
BAIDU_MAP_AK=

# 百度地图「浏览器端」应用 AK（JavaScript API GL，用于页面地图展示）
# 应用类型选「浏览器端」，白名单配置 Referer（如 http://localhost:5173/*）
# 注意：与服务端 AK 是不同应用、不同 AK，不可混用；Vite 要求变量名以 VITE_ 开头
VITE_BAIDU_MAP_AK=

# LLM API（OpenAI 兼容协议，可对接任意兼容 /v1/chat/completions 的服务）
# 示例：
#   OpenAI:    LLM_API_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o
#   DeepSeek:  LLM_API_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   通义千问:  LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   本地 Ollama: LLM_API_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Agent 并发数
AGENT_MAX_CONCURRENCY=4
